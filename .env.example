# ---------------------------------------------------------------------------
# Garmin access — pick ONE backend
#
# auto (default): use the official Personal API when GARMIN_PERSONAL_API_KEY is
#                 set, otherwise fall back to the email/password flow.
# personal:       official Personal API only. Stable, rate-limit friendly, but it
#                 cannot read Garmin-derived metrics (training status/load,
#                 readiness, VO2 Max, race predictions, personal records).
# unofficial:     email/password flow via `garminconnect`. Full metric coverage,
#                 but it fights SSO/Cloudflare and can rate-limit.
# hybrid:         BOTH. Wellness/raw reads go to the official API, derived
#                 metrics go to email/password, with fallback if one fails.
#                 Needs GARMIN_PERSONAL_API_KEY *and* GARMIN_EMAIL/PASSWORD.
# See docs/personal-api.md.
# ---------------------------------------------------------------------------
GARMIN_AUTH_MODE=auto

# Official backend (recommended for daily wellness data + raw .FIT files).
# Create a key at https://connect.garmin.com/app/settings/personalApiToken
# Keys expire after 30/90/180/365 days; the bearer token is valid 24 hours and
# is cached next to the token store below.
GARMIN_PERSONAL_API_KEY=
GARMIN_PERSONAL_TOKEN_CACHE=~/.garminconnect/personal_api_token.json
GARMIN_PERSONAL_BASE_URL=https://personal.connectapi.garmin.com
GARMIN_PERSONAL_TIMEOUT_SECONDS=20
# The Personal API rate-limits hard (12 parallel requests -> 429 + Retry-After).
# Keep concurrency low and let the range-cache do the work.
GARMIN_PERSONAL_MAX_CONCURRENCY=2
GARMIN_PERSONAL_BATCH_DAYS=28
GARMIN_PERSONAL_BATCH_TTL_SECONDS=900

# Unofficial backend (email/password).
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-password
GARMIN_TOKEN_STORE=~/.garminconnect

GARMIN_CACHE_TTL_SECONDS=120
GARMIN_MAX_CONCURRENCY=3
# After a failed email/password login, pause new login attempts (all processes) this long.
GARMIN_LOGIN_COOLDOWN_SECONDS=900

# Air quality for your usual running areas (Open-Meteo, no key). Only start points
# rounded to this grid (degrees; 0.01 ~ 1 km) are sent. AIR_QUALITY_ENABLED=0 turns it off.
AIR_QUALITY_ENABLED=1
AIR_QUALITY_GRID_DEG=0.01
GARMIN_APP_VERSION=5.30.1
# Phone sent in the X-Garmin-User-Agent header: "maker/model/brand; Android/API level".
GARMIN_DEVICE=samsung/SM-S928B/samsung; Android/35

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3-flash-preview

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash
